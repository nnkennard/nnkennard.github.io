<div>

<a href="https://doi.org/{{ entry.doi }}" target="_blank"><b>{{entry.title}}</b><br></a>
{{entry.authors}} <br> {{entry.venueyear}} | 
 

{% if entry.pdf %}

    {% if entry.pdf contains '://' %}
        {% assign pdfref = entry.pdf %}
    {% else %}
        {% assign pdfref = entry.key | append: '.pdf' | prepend: '/assets/pdf/papers/' | relative_url %}
    {% endif %}

    <a href="{{ pdfref }}" target="_blank">pdf</a>
    {% if entry.code or entry.poster or entry.slides %} | {% endif %}

{% endif %}

{% if entry.code %}

    <a href="{{ entry.code }}">code</a>
    {% if entry.poster or entry.slides %} | {% endif %}

{% endif %}

{% if entry.poster %}

    <a href="{{ entry.key | append: '_poster.pdf' | prepend: '/assets/pdf/posters/' | relative_url }}">poster</a>
    {% if  entry.slides %} | {% endif %}

{% endif %}

{% if entry.slides %}

    <a href="{{ entry.key | append: '_slides.pdf' | prepend: '/assets/pdf/slides/' | relative_url }}" >slides</a>

{% endif %}

<br> <br>
</div>
